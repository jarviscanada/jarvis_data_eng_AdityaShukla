      "text": "%spark.sql\r\n\r\nSELECT\r\n  countryname AS country_name,\r\n  year,\r\n  indicatorvalue AS GDP_growth_value\r\nFROM (\r\n  SELECT\r\n    countryname,\r\n    year,\r\n    indicatorvalue,\r\n    ROW_NUMBER() OVER (\r\n      PARTITION BY countryname\r\n      ORDER BY indicatorvalue DESC\r\n    ) AS rn\r\n  FROM wdi_csv_parquet\r\n  WHERE indicatorcode = 'NY.GDP.MKTP.KD.ZG'\r\n) t\r\nWHERE rn = 1;",
